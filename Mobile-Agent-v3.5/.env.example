# =============================================================================
# Mobile-Agent-v3.5 Configuration Template
# =============================================================================
# Usage:
#   1. Copy this file to .env (next to it):
#        cp .env.example .env
#   2. Fill in your real values below.
#   3. The run_* scripts will auto-load this file at startup.
#   4. NEVER commit the real .env file to git (already gitignored).
# =============================================================================


# ----- Vision Model (required) -----------------------------------------------
# OpenAI-compatible Chat Completions endpoint that serves a vision-capable LLM
# (GUI-Owl-1.5 / Qwen-VL / Qwen3-VL / etc.).
VISION_MODEL_API_KEY=your-api-key-here
VISION_MODEL_BASE_URL=https://your-llm-service.example.com/v1
VISION_MODEL_NAME=your-model-name


# ----- App Resolver Model (optional, mobile only) ----------------------------
# A lighter text-only LLM used to map free-form app names ("打开微信") to
# installed package names. Falls back to VISION_MODEL_* if left blank.
APP_RESOLVER_API_KEY=
APP_RESOLVER_BASE_URL=
APP_RESOLVER_MODEL=qwen-plus


# ----- ADB Path (optional, mobile only) --------------------------------------
# Absolute path to the adb binary. Can also be passed via --adb_path.
#   macOS / Linux example: /usr/local/bin/adb
#   Windows example:       C:\platform-tools\adb.exe
ADB_PATH=


# ----- Default Run Options (optional) ----------------------------------------
# Maximum number of agent steps before giving up.
MAX_STEPS=50
